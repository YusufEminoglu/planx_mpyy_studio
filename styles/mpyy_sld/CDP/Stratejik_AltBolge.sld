<?xml version='1.0' encoding='utf-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0.0" xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
	<NamedLayer>
		<Name>CDP_STRATEJIK_ALT_BOLGE</Name>
		<UserStyle>
			<Title>CDP_STRATEJIK_ALT_BOLGE</Title>
			<FeatureTypeStyle>
				<Rule>
					<Title>STRATEJİK ALT BÖLGE</Title>
					<LineSymbolizer>
						<Stroke>
							<GraphicStroke>
								<Graphic>
									<Mark>
										<WellKnownName>circle</WellKnownName>
										<Stroke />
									</Mark>
									<Size>12</Size>
								</Graphic>
							</GraphicStroke>
							<CssParameter name="stroke-dashoffset">10</CssParameter>
							<CssParameter name="stroke-dasharray">10.0 4.0</CssParameter>
						</Stroke>
					</LineSymbolizer>
					<LineSymbolizer>
						<Stroke>
							<GraphicStroke>
								<Graphic>
									<Mark>
										<WellKnownName>shape://times</WellKnownName>
										<Stroke />
									</Mark>
									<Size>9</Size>
								</Graphic>
							</GraphicStroke>
							<CssParameter name="stroke-dashoffset">8</CssParameter>
							<CssParameter name="stroke-dasharray">5.0 9.0</CssParameter>
						</Stroke>
					</LineSymbolizer>
				</Rule>
			</FeatureTypeStyle>
		</UserStyle>
	</NamedLayer>
</StyledLayerDescriptor>