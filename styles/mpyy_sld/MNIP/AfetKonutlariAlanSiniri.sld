<?xml version='1.0' encoding='utf-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0.0" xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
	<NamedLayer>
		<Name>MNIP_AFET_KONUT_ALAN_SINIR</Name>
		<UserStyle>
			<Title>MNIP_AFET_KONUT_ALAN_SINIR</Title>
			<FeatureTypeStyle>
				<Rule>
					<Name>0</Name>
					<Title>MNIP_AFET_KONUT_ALAN_SINIR</Title>
					<MaxScaleDenominator>80000</MaxScaleDenominator>
					<LineSymbolizer uom="http://www.opengeospatial.org/se/units/metre">
						<Stroke>
							<CssParameter name="stroke">#000000</CssParameter>
							<CssParameter name="stroke-width">0.3528</CssParameter>
							<CssParameter name="stroke-dasharray">10 5</CssParameter>
						</Stroke>
					</LineSymbolizer>
				</Rule>
			</FeatureTypeStyle>
		</UserStyle>
	</NamedLayer>
</StyledLayerDescriptor>