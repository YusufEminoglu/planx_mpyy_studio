				</Rule>
				<Rule>
					<Name>0</Name>
					<Title>KOTU</Title>
					<MaxScaleDenominator>50000</MaxScaleDenominator>
					<ogc:Filter>
						<ogc:PropertyIsEqualTo>
							<ogc:PropertyName>MeraSinif</ogc:PropertyName>
							<ogc:Literal>Kotu</ogc:Literal>
