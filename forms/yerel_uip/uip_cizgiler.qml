  <actionsetting name="v2" action="# QGIS Action: Yol Platformu Oluşturucu&#xd;&#xa;# Seçilen yol orta çizgilerinden refüj, sağ kaldırım, sol kaldırım çizgileri üretir ve yeni geçici katmana ekler&#xd;&#xa;&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject, QgsFeature, QgsVectorLayer, QgsFields, QgsField,&#xd;&#xa;    QgsGeometry, QgsWkbTypes, QgsFeatureRequest&#xd;&#xa;)&#xd;&#xa;from PyQt5.QtCore import QVariant&#xd;&#xa;&#xd;&#xa;# Girdi: Yol orta çizgisi katmanı (uipLineDemo)&#xd;&#xa;layer_id = '[%@layer_id%]'&#xd;&#xa;fid = [% $id %]&#xd;&#xa;line_layer = QgsProject.instance().mapLayer(layer_id)&#xd;&#xa;line_feature = line_layer.getFeature(fid)&#xd;&#xa;&#xd;&#xa;# Geçici katman tanımı&#xd;&#xa;fields = QgsFields()&#xd;&#xa;fields.append(QgsField(&quot;source_id&quot;, QVariant.Int))&#xd;&#xa;fields.append(QgsField(&quot;tip&quot;, QVariant.String))&#xd;&#xa;&#xd;&#xa;out_layer = QgsVectorLayer(&quot;LineString?crs=EPSG:5253&quot;, &quot;yol_platformu_cizgileri&quot;, &quot;memory&quot;)&#xd;&#xa;out_dp = out_layer.dataProvider()&#xd;&#xa;out_dp.addAttributes(fields)&#xd;&#xa;out_layer.updateFields()&#xd;&#xa;&#xd;&#xa;added = 0&#xd;&#xa;&#xd;&#xa;for feat in line_layer.getFeatures():&#xd;&#xa;    geom = feat.geometry()&#xd;&#xa;    if not geom:&#xd;&#xa;        continue&#xd;&#xa;&#xd;&#xa;    try:&#xd;&#xa;        # Genişlik verilerini oku&#xd;&#xa;        kaldirim = float(feat['kaldirimGenislik']) if feat['kaldirimGenislik'] else 0&#xd;&#xa;        refuj = float(feat['refujGenislik']) if feat['refujGenislik'] else 0&#xd;&#xa;        sag = int(feat['SagSeritSayisi']) if feat['SagSeritSayisi'] else 0&#xd;&#xa;        sol = int(feat['SolSeritSayisi']) if feat['SolSeritSayisi'] else 0&#xd;&#xa;        serit = 3.5&#xd;&#xa;&#xd;&#xa;        yol_sag = sag * serit&#xd;&#xa;        yol_sol = sol * serit&#xd;&#xa;&#xd;&#xa;        # Geometrileri üret&#xd;&#xa;        refuj_sag_offset = refuj / 2&#xd;&#xa;        refuj_sol_offset = -refuj / 2&#xd;&#xa;        kald_sag_offset = refuj_sag_offset + kaldirim + yol_sag&#xd;&#xa;        kald_sol_offset = refuj_sol_offset - kaldirim - yol_sol&#xd;&#xa;&#xd;&#xa;        refuj_sag = geom.offsetCurve(refuj_sag_offset)&#xd;&#xa;        refuj_sol = geom.offsetCurve(refuj_sol_offset)&#xd;&#xa;        kaldirim_sag = geom.offsetCurve(kald_sag_offset)&#xd;&#xa;        kaldirim_sol = geom.offsetCurve(kald_sol_offset)&#xd;&#xa;&#xd;&#xa;        # Çizgi üret fonksiyonu&#xd;&#xa;        def add_line(g, tip):&#xd;&#xa;            if g and not g.isEmpty():&#xd;&#xa;                f = QgsFeature(out_layer.fields())&#xd;&#xa;                f.setGeometry(g)&#xd;&#xa;                f.setAttribute(&quot;source_id&quot;, feat.id())&#xd;&#xa;                f.setAttribute(&quot;tip&quot;, tip)&#xd;&#xa;                out_dp.addFeature(f)&#xd;&#xa;&#xd;&#xa;        add_line(refuj_sag, &quot;refuj_sag&quot;)&#xd;&#xa;        add_line(refuj_sol, &quot;refuj_sol&quot;)&#xd;&#xa;        add_line(kaldirim_sag, &quot;kaldirim_sag&quot;)&#xd;&#xa;        add_line(kaldirim_sol, &quot;kaldirim_sol&quot;)&#xd;&#xa;        added += 4&#xd;&#xa;&#xd;&#xa;    except Exception as e:&#xd;&#xa;        print(f&quot;Hata (fid={feat.id()}): {e}&quot;)&#xd;&#xa;&#xd;&#xa;QgsProject.instance().addMapLayer(out_layer)&#xd;&#xa;print(f&quot;Yol platformu çizgileri oluşturuldu: {added} çizgi eklendi.&quot;)&#xd;&#xa;" icon="" id="{18ab4c3e-452e-426e-b6f7-6e78e05e4156}" capture="0" type="1" notificationMessage="" shortTitle="" isEnabledOnlyWhenEditable="1">
   <actionScope id="Feature"/>
   <actionScope id="Canvas"/>
  </actionsetting>
